      "message": "« ça » (cédille) ou « çà »",
      "replace": "ça"
    },
    {
      "id": "ou-est",
      "flags": "i",
      "pattern": "\\bou est\\b",
      "message": "« où est » (lieu)",
      "replace": "où est"
    },
    {
      "id": "quoi que-quoique",
      "flags": "i",
      "pattern": "\\bquoique? tu (fasses|dises|veuilles)\\b",
      "message": "« quoi que » en deux mots (quelle que soit la chose que)",
      "replace": "quoi que tu $1"
    },
    {
      "id": "cote-a-cote",
      "flags": "i",
      "pattern": "\\b(?:cote [aà] c[oô]te|côte a c[oô]te|côte à cote)\\b",
      "message": "« côte à côte » : l'un à côté de l'autre",
      "replace": "côte à côte"
    },
    {
      "id": "la-bas",
      "flags": "i",
      "pattern": "\\b(?:là|la) bas\\b",
      "message": "« là-bas » prend un tiret",
      "replace": "là-bas"
    },
    {
      "id": "c-est-a-dire",
      "flags": "i",
      "pattern": "\\bc'est [aà] dire\\b",
      "message": "« c'est-à-dire » prend deux tirets",
      "replace": "c'est-à-dire"
    },
    {
      "id": "au-dessus",
      "flags": "i",
      "pattern": "\\b(au|là|ci|par|en) (dessus|dessous|dedans|dehors|devant|delà)\\b",
      "message": "Locution : un tiret (« au-dessus », « là-dedans »)",
      "replace": "$1-$2"
    },
    {
      "id": "celui-ci",
      "flags": "i",
      "pattern": "\\b(celui|celle|ceux|celles) ci\\b",
