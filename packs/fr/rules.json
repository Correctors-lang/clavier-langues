    },
    {
      "id": "rendez-vous",
      "flags": "i",
      "pattern": "\\brendez vous\\b",
      "message": "« rendez-vous » prend un tiret",
      "replace": "rendez-vous"
    },
    {
      "id": "grand-mere",
      "flags": "i",
