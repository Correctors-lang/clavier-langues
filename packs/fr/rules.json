      "replace": null
    },
    {
      "id": "ce-que-je-crois-que",
      "flags": "i",
      "pattern": "\\bpour que? (?:soit|sois)\\b",
      "message": "vérifiez le subjonctif",
      "replace": null
    },
    {
      "id": "ta-vs-tas",
      "flags": "i",
      "pattern": "\\bt'?as +(m[eè]re|meuf|reum|race|gueule|s(?:oe|œ)ur|daronne|femme|fille|bouche|main|place|chambre|gueule)\\b",
      "message": "« ta » = déterminant possessif ; « t'as » = tu as",
      "replace": "ta $1"
    },
    {
      "id": "ra-pour-ta",
      "flags": "i",
      "pattern": "\\bras? +(m[eè]re|meuf|reum|race|gueule|s(?:oe|œ)ur|daronne)\\b",
      "message": "« ta » attendu ici",
      "replace": "ta $1"
    },
    {
      "id": "ma-vs-m-a",
      "flags": "i",
      "pattern": "\\bm'a +(m[eè]re|meuf|voiture|maison|s(?:oe|œ)ur|femme|fille|place|bouche|chambre)\\b",
      "message": "« ma » = possessif ; « m'a » = me + a (verbe avoir)",
      "replace": "ma $1"
    },
    {
      "id": "leur-verbe",
      "flags": "i",
      "pattern": "\\b(je|tu|il|elle|on|nous|vous|ils|elles) +leurs +(ai|as|a|avons|avez|ont|dis|dit|donne|donné|parle|parlé|demande|demandé|explique|expliqué|envoie|envoyé)\\b",
      "message": "« leur » devant un verbe est invariable",
      "replace": "$1 leur $2"
    },
    {
      "id": "des-fois",
      "flags": "i",
      "pattern": "\\bdes fois\\b",
      "message": "registre familier : préférez « parfois »",
      "replace": "parfois"
    },
    {
      "id": "ca-vas",
      "flags": "i",
      "pattern": "\\b[cç]a vas\\b",
      "message": "« ça va » (3e personne)",
      "replace": "ça va"
    },
    {
      "id": "sa-va",
      "flags": "i",
      "pattern": "\\bsa va\\b",
      "message": "« ça va » (cela), pas « sa »",
      "replace": "ça va"
    },
    {
      "id": "au-niveau",
      "flags": "i",
      "pattern": "\\bau niveau de\\b",
      "message": "tic de langage : « au niveau de »",
      "replace": null
    },
    {
      "id": "voila-t",
      "flags": "i",
      "pattern": "\\bvoila\\b",
