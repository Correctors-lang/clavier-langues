{
  "_comment": "Règles de grammaire françaises. 'regex' = expressions figées / fautes lexicales ; 'confusions' = homophones avec indices de contexte. Éditez librement, aucun code à toucher.",
  "regex": [
    {
      "id": "malgre-que",
      "flags": "i",
      "pattern": "\\bmalgré qu[e']\\b",
      "message": "« malgré que » est fautif",
      "replace": "bien que"
    },
    {
      "id": "pallier-a",
      "flags": "i",
      "pattern": "\\bpallier à\\b",
